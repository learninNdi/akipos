/* ============================================================
   AKIPOS - DASHBOARD STYLE
   ============================================================ */


/* ============================================================
   PAGE
   ============================================================ */

#dashboardPage {
    background: #f5f7fa;
}


/* ============================================================
   PAGE HEADER
   ============================================================ */

#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #1f2937;
    margin: 0;
}

#pageSubtitle {
    font-size: 14px;
    color: #6b7280;
    margin-top: -12px;
}


/* ============================================================
   SUMMARY CARDS
   ============================================================ */

#salesCard,
#transactionCard,
#profitCard,
#stockCard {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}


/* ============================================================
   CARD HOVER
   ============================================================ */

#salesCard:hover,
#transactionCard:hover,
#profitCard:hover,
#stockCard:hover {
    border: 1px solid #d1d5db;
}


/* ============================================================
   CARD TITLE
   ============================================================ */

#cardTitle {
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
}


/* ============================================================
   CARD VALUE
   ============================================================ */

#cardValue {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
}


/* ============================================================
   INDIVIDUAL CARD
   ============================================================ */

#salesCard {
    border-left: 4px solid #2563eb;
}

#transactionCard {
    border-left: 4px solid #7c3aed;
}

#profitCard {
    border-left: 4px solid #16a34a;
}

#stockCard {
    border-left: 4px solid #f59e0b;
}


/* ============================================================
   DASHBOARD PANELS
   ============================================================ */

#dashboardPanel {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}


/* ============================================================
   PANEL TITLE
   ============================================================ */

#panelTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1f2937;
}


/* ============================================================
   EMPTY STATE
   ============================================================ */

#emptyLabel {
    font-size: 14px;
    color: #9ca3af;
}